<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Gemini Ultra Clone</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
        .dark ::-webkit-scrollbar-thumb { background: #475569; }
        
        /* Mobile Keyboard Fix */
        html, body { height: 100%; overflow: hidden; }
        #app-root { height: 100%; display: flex; flex-direction: column; }
        
        /* Message Styles */
        .markdown-body pre { background: #f1f5f9; padding: 1rem; border-radius: 0.5rem; overflow-x: auto; margin: 0.5rem 0; }
        .dark .markdown-body pre { background: #1e293b; color: #f8fafc; }
        .message-bubble { max-width: 85%; transition: all 0.2s ease; }
        
        /* Sidebar Transitions */
        #sidebar { transition: transform 0.3s ease-in-out; z-index: 50; }
        
        #loading-overlay {
            position: fixed; inset: 0; background: white; 
            display: flex; flex-direction: column; align-items: center; justify-content: center; z-index: 100;
        }
        .dark #loading-overlay { background: #0f172a; color: white; }
    </style>
</head>
<body class="bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100 transition-colors duration-200">

    <div id="loading-overlay">
        <div class="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-blue-500 mb-4"></div>
        <p class="font-medium">Initializing AI Interface...</p>
    </div>

    <div id="app-root" class="hidden">
        <div class="flex h-full overflow-hidden">
            
            <aside id="sidebar" class="fixed inset-y-0 left-0 w-72 bg-white dark:bg-slate-900 border-r border-slate-200 dark:border-slate-800 transform -translate-x-full lg:translate-x-0 lg:static lg:block flex-shrink-0">
                <div class="flex flex-col h-full">
                    <div class="p-4 border-b dark:border-slate-800 flex justify-between items-center">
                        <h1 class="font-bold text-xl text-blue-600">Gemini Clone</h1>
                        <button onclick="toggleSidebar()" class="lg:hidden p-2"><i class="fas fa-times"></i></button>
                    </div>
                    
                    <button onclick="createNewChat()" class="m-4 p-3 rounded-full border border-slate-300 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center gap-3 transition-all">
                        <i class="fas fa-plus text-blue-500"></i>
                        <span>New Chat</span>
                    </button>

                    <div id="chat-list" class="flex-1 overflow-y-auto px-2 space-y-1">
                        </div>

                    <div class="p-4 border-t dark:border-slate-800 space-y-2">
                        <button onclick="toggleDarkMode()" class="w-full flex items-center gap-3 p-2 hover:bg-slate-100 dark:hover:bg-slate-800 rounded">
                            <i class="fas fa-moon"></i> <span>Appearance</span>
                        </button>
                        <button onclick="openSettings()" class="w-full flex items-center gap-3 p-2 hover:bg-slate-100 dark:hover:bg-slate-800 rounded">
                            <i class="fas fa-cog"></i> <span>Settings</span>
                        </button>
                    </div>
                </div>
            </aside>

            <main class="flex-1 flex flex-col min-w-0 bg-white dark:bg-slate-950 relative">
                <header class="h-14 border-b dark:border-slate-800 flex items-center justify-between px-4 lg:px-8">
                    <div class="flex items-center gap-3">
                        <button onclick="toggleSidebar()" class="lg:hidden p-2 text-slate-500"><i class="fas fa-bars"></i></button>
                        <span id="current-chat-title" class="font-medium truncate max-w-[200px]">New Conversation</span>
                    </div>
                    <div class="text-xs font-mono text-slate-400" id="model-indicator">...</div>
                </header>

                <div id="chat-container" class="flex-1 overflow-y-auto p-4 lg:px-20 space-y-6 pb-32">
                    </div>

                <div class="absolute bottom-0 left-0 right-0 p-4 bg-gradient-to-t from-white dark:from-slate-950 via-white dark:via-slate-950">
                    <div class="max-w-4xl mx-auto relative">
                        <textarea id="user-input" rows="1" 
                            class="w-full p-4 pr-14 rounded-2xl border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 focus:ring-2 focus:ring-blue-500 focus:outline-none resize-none shadow-sm"
                            placeholder="Type your message..."></textarea>
                        <button id="send-btn" onclick="handleSend()" 
                            class="absolute right-3 bottom-3 p-2 bg-blue-600 text-white rounded-xl hover:bg-blue-700 disabled:opacity-50 transition-colors">
                            <i class="fas fa-paper-plane"></i>
                        </button>
                    </div>
                    <p class="text-[10px] text-center mt-2 text-slate-400">Powered by OpenRouter. AI can make mistakes.</p>
                </div>
            </main>
        </div>

        <div id="settings-modal" class="fixed inset-0 bg-black/50 hidden z-[100] flex items-center justify-center p-4">
            <div class="bg-white dark:bg-slate-900 w-full max-w-md rounded-2xl p-6 shadow-2xl">
                <div class="flex justify-between items-center mb-6">
                    <h2 class="text-xl font-bold">Settings</h2>
                    <button onclick="closeSettings()"><i class="fas fa-times"></i></button>
                </div>
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium mb-1">OpenRouter API Key</label>
                        <input type="password" id="api-key-input" class="w-full p-2 rounded border dark:bg-slate-800 dark:border-slate-700" placeholder="sk-or-...">
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-1">Model ID</label>
                        <input type="text" id="model-input" class="w-full p-2 rounded border dark:bg-slate-800 dark:border-slate-700" placeholder="deepseek/deepseek-r1:free">
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-1">System Prompt</label>
                        <textarea id="system-prompt-input" class="w-full p-2 rounded border dark:bg-slate-800 dark:border-slate-700 h-24" placeholder="You are a helpful assistant..."></textarea>
                    </div>
                    <button onclick="saveSettings()" class="w-full bg-blue-600 text-white p-3 rounded-xl font-bold hover:bg-blue-700 transition-colors">Save & Close</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        // --- State Management ---
        let state = {
            apiKey: localStorage.getItem('or_api_key') || '',
            model: localStorage.getItem('or_model') || 'deepseek/deepseek-r1:free',
            systemPrompt: localStorage.getItem('or_system') || 'You are a helpful, smart AI assistant.',
            chats: JSON.parse(localStorage.getItem('or_chats')) || [],
            currentChatId: null,
            isStreaming: false
        };

        // --- Initialization ---
        window.onload = () => {
            const loading = document.getElementById('loading-overlay');
            const root = document.getElementById('app-root');
            
            // Apply theme
            if (localStorage.getItem('dark_mode') === 'true') {
                document.documentElement.classList.add('dark');
            }

            // Load last chat or create new
            if (state.chats.length > 0) {
                switchChat(state.chats[0].id);
            } else {
                createNewChat();
            }

            updateSidebar();
            updateModelIndicator();
            
            loading.classList.add('hidden');
            root.classList.remove('hidden');

            // Auto-resize textarea
            const textarea = document.getElementById('user-input');
            textarea.addEventListener('input', function() {
                this.style.height = 'auto';
                this.style.height = (this.scrollHeight) + 'px';
                if (this.scrollHeight > 200) this.style.overflowY = 'scroll';
            });
            
            textarea.addEventListener('keydown', (e) => {
                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    handleSend();
                }
            });
        };

        // --- UI Actions ---
        function toggleSidebar() {
            const sb = document.getElementById('sidebar');
            sb.classList.toggle('-translate-x-full');
        }

        function toggleDarkMode() {
            const isDark = document.documentElement.classList.toggle('dark');
            localStorage.setItem('dark_mode', isDark);
        }

        function openSettings() {
            document.getElementById('api-key-input').value = state.apiKey;
            document.getElementById('model-input').value = state.model;
            document.getElementById('system-prompt-input').value = state.systemPrompt;
            document.getElementById('settings-modal').classList.remove('hidden');
        }

        function closeSettings() {
            document.getElementById('settings-modal').classList.add('hidden');
        }

        function saveSettings() {
            state.apiKey = document.getElementById('api-key-input').value.trim();
            state.model = document.getElementById('model-input').value.trim();
            state.systemPrompt = document.getElementById('system-prompt-input').value.trim();
            
            localStorage.setItem('or_api_key', state.apiKey);
            localStorage.setItem('or_model', state.model);
            localStorage.setItem('or_system', state.systemPrompt);
            
            updateModelIndicator();
            closeSettings();
        }

        function updateModelIndicator() {
            document.getElementById('model-indicator').innerText = state.model.split('/').pop();
        }

        // --- Chat Logic ---
        function createNewChat() {
            const newChat = {
                id: Date.now().toString(),
                title: 'New Conversation',
                messages: []
            };
            state.chats.unshift(newChat);
            saveToLocal();
            switchChat(newChat.id);
            updateSidebar();
        }

        function switchChat(id) {
            state.currentChatId = id;
            const chat = state.chats.find(c => c.id === id);
            document.getElementById('current-chat-title').innerText = chat.title;
            renderMessages();
            updateSidebar();
            if (window.innerWidth < 1024) toggleSidebar();
        }

        function deleteChat(id, event) {
            event.stopPropagation();
            state.chats = state.chats.filter(c => c.id !== id);
            if (state.currentChatId === id) {
                if (state.chats.length > 0) switchChat(state.chats[0].id);
                else createNewChat();
            }
            saveToLocal();
            updateSidebar();
        }

        function updateSidebar() {
            const list = document.getElementById('chat-list');
            list.innerHTML = state.chats.map(chat => `
                <div onclick="switchChat('${chat.id}')" class="group flex items-center justify-between p-3 rounded-lg cursor-pointer ${state.currentChatId === chat.id ? 'bg-blue-50 dark:bg-blue-900/20 text-blue-600' : 'hover:bg-slate-100 dark:hover:bg-slate-800'}">
                    <div class="flex items-center gap-3 truncate">
                        <i class="far fa-comment-alt"></i>
                        <span class="truncate text-sm">${chat.title}</span>
                    </div>
                    <button onclick="deleteChat('${chat.id}', event)" class="opacity-0 group-hover:opacity-100 p-1 hover:text-red-500 transition-opacity">
                        <i class="fas fa-trash-alt text-xs"></i>
                    </button>
                </div>
            `).join('');
        }

        function renderMessages() {
            const container = document.getElementById('chat-container');
            const chat = state.chats.find(c => c.id === state.currentChatId);
            
            if (!chat || chat.messages.length === 0) {
                container.innerHTML = `
                    <div class="h-full flex flex-col items-center justify-center text-slate-400 space-y-4 mt-20">
                        <i class="fas fa-robot text-6xl opacity-20"></i>
                        <p class="text-lg">How can I help you today?</p>
                    </div>
                `;
                return;
            }

            container.innerHTML = chat.messages.map(m => `
                <div class="flex ${m.role === 'user' ? 'justify-end' : 'justify-start'}">
                    <div class="message-bubble p-4 rounded-2xl shadow-sm markdown-body ${
                        m.role === 'user' 
                        ? 'bg-blue-600 text-white rounded-tr-none' 
                        : 'bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-100 rounded-tl-none'
                    }">
                        <div class="text-xs mb-1 opacity-50 font-bold uppercase tracking-widest">
                            ${m.role === 'user' ? 'You' : 'AI'}
                        </div>
                        <div>${marked.parse(m.content)}</div>
                    </div>
                </div>
            `).join('');
            container.scrollTo(0, container.scrollHeight);
        }

        // --- Core API & Streaming ---
        async function handleSend() {
            if (state.isStreaming) return;
            
            const input = document.getElementById('user-input');
            const text = input.value.trim();
            
            if (!text) return;
            if (!state.apiKey) {
                alert('Please set your OpenRouter API Key in Settings first!');
                openSettings();
                return;
            }

            const chat = state.chats.find(c => c.id === state.currentChatId);
            
            // Set first message as title
            if (chat.messages.length === 0) {
                chat.title = text.substring(0, 30) + (text.length > 30 ? '...' : '');
                updateSidebar();
            }

            chat.messages.push({ role: 'user', content: text });
            input.value = '';
            input.style.height = 'auto';
            renderMessages();

            // Prepare for AI response
            state.isStreaming = true;
            document.getElementById('send-btn').disabled = true;
            
            const aiMsg = { role: 'assistant', content: '' };
            chat.messages.push(aiMsg);
            renderMessages();

            try {
                const response = await fetch("https://openrouter.ai/api/v1/chat/completions", {
                    method: "POST",
                    headers: {
                        "Authorization": `Bearer ${state.apiKey}`,
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        model: state.model,
                        messages: [
                            { role: "system", content: state.systemPrompt },
                            ...chat.messages.slice(0, -1)
                        ],
                        stream: true
                    })
                });

                const reader = response.body.getReader();
                const decoder = new TextDecoder();
                const container = document.getElementById('chat-container');
                const lastBubble = container.lastElementChild.querySelector('.markdown-body div:last-child');

                while (true) {
                    const { done, value } = await reader.read();
                    if (done) break;

                    const chunk = decoder.decode(value);
                    const lines = chunk.split('\n');
                    
                    for (const line of lines) {
                        if (line.startsWith('data: ')) {
                            const dataStr = line.slice(6);
                            if (dataStr === '[DONE]') break;
                            try {
                                const data = JSON.parse(dataStr);
                                const content = data.choices[0].delta.content || '';
                                aiMsg.content += content;
                                // Update UI in real-time
                                lastBubble.innerHTML = marked.parse(aiMsg.content);
                                container.scrollTo(0, container.scrollHeight);
                            } catch (e) { /* partial chunk */ }
                        }
                    }
                }
            } catch (err) {
                aiMsg.content = `**Error:** ${err.message}. Please check your API key and internet connection.`;
                renderMessages();
            } finally {
                state.isStreaming = false;
                document.getElementById('send-btn').disabled = false;
                saveToLocal();
            }
        }

        function saveToLocal() {
            localStorage.setItem('or_chats', JSON.stringify(state.chats));
        }

    </script>
</body>
</html>

